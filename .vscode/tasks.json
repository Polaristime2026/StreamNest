{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake -S backend -B backend/build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake --build backend/build",
            "group": "build",
            "dependsOn": "CMake: Configure",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run: edu_auth_server",
            "type": "shell",
            "command": "${workspaceFolder}/backend/build/edu_auth_server",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Serve: views (python http.server)",
            "type": "shell",
            "command": "python -m http.server 5500",
            "options": {
                "cwd": "${workspaceFolder}/views"
            },
            "group": "none",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "D:/msys2/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "D:/msys2/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}